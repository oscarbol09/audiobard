{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioBard",
  "version": "0.1.0",
  "identifier": "com.audiobard.app",
  "build": {
    "frontendDist": "../gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../gui",
    "beforeBuildCommand": "npm run build --prefix ../gui"
  },
  "app": {
    "windows": [
      {
        "title": "AudioBard",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "shell": {
      "sidecar": {
        "python-sidecar": {
          "args": ["-m", "uvicorn", "audiobard.api:app", "--host", "0.0.0.0", "--port", "8000"],
          "env": {
            "PYTHONPATH": "${resourceDir}/../src"
          }
        }
      }
    }
  }
}